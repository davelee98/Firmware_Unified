# PlatformIO (targets/esp32-nrf52840-pio)
.pio/
.pioenvs/
.piolibdeps/
platformio.local.ini

# Zephyr / nRF Connect SDK (targets/nrf54l15-zephyr)
build/
# `./build.sh --all` in targets/nordic-zephyr/ gives each board its own build dir
# (build-xiao_nrf54l15/, build-xiao_ble/, ...): sharing one would make every board a full
# rebuild and leave only the last as something flash.sh could find.
build-*/
twister-out*/
.west/

# Simplicity SDK / SLC (targets/efr32bg22-slc)
autogen/
cmake_gcc/build/
*.slps
artifact/

# ...EXCEPT these three. They live in autogen/ and carry the "Automatically-generated"
# banner, but they are HAND-EDITED and `slc generate` REVERTS both edits (found
# 2026-08-05 by regenerating and diffing -- see targets/efr32bg22-slc/README.md
# § "autogen/ is not entirely generated"). Nothing else holds these values, so if
# they are not committed they are lost:
#
#   linkerfile.ld  FLASH ORIGIN 0x12000 LEN 0x44000 (above the Gecko Bootloader +
#                  AppLoader) plus BOOTLOADER_RESET_REGION. Regenerated it links at
#                  0x0 over the bootloader, which destroys the .gbl OTA path -- the
#                  only field-update path any OpenDisplay target has.
#   gatt_db.c/.h   the GATT trimmed to GAP + Device Name. Regenerated it restores the
#                  stock Silabs Device Information Service and MOVES gattdb_device_name
#                  from handle 3 to 11 -- a wire-visible change on shipped hardware.
#
# This is a stopgap that keeps the facts in git. The real fix is to move both edits
# somewhere they are not shadowed by a generator; until then, do not "clean up" these
# negations.
!targets/efr32bg22-slc/autogen/
targets/efr32bg22-slc/autogen/*
!targets/efr32bg22-slc/autogen/linkerfile.ld
!targets/efr32bg22-slc/autogen/gatt_db.c
!targets/efr32bg22-slc/autogen/gatt_db.h

# Nordic SDK (targets/nrf52-sdk)
_build/

# Build artefacts
*.o
*.a
*.elf
*.bin
*.hex
*.uf2
*.map
*.gbl

# Release output. `targets/esp32-idf/build.sh` delivers merged, ready-to-flash images here.
# The *.bin rule above already covers the images; this also catches MANIFEST.txt, which is
# generated alongside them and is build output, not a checked-in record. Ignoring the whole
# directory keeps `git status` quiet after a build -- and release artefacts belong on a
# release, not in history.
/release/

# Editors / OS
.vscode/
.idea/
.DS_Store
*.swp

# Secrets and provisioning — never commit these
*.pem
*.key
secrets.*
factory_config*.hex

# ESP-IDF build artefacts (targets/esp32-idf builds out-of-tree, but idf.py defaults to ./build)
build/
sdkconfig
sdkconfig.old

# Agent worktrees -- transient, and each is its own git repo. Never part of a commit here.
.claude/worktrees/

# IDF component-manager lock file. Generated because the vendored mdns component carries its
# own idf_component.yml; it records only `idf` itself (nothing is fetched -- the component is
# found locally), and it is REWRITTEN PER BOARD with that board's `target:` line, so committing
# it would mean a diff on every build of a different board.
dependencies.lock

# PlatformIO (targets/esp32-nrf52840-pio)
.pio/
.pioenvs/
.piolibdeps/
platformio.local.ini

# Zephyr / nRF Connect SDK (targets/nrf54l15-zephyr)
build/
twister-out*/
.west/

# Simplicity SDK / SLC (targets/efr32bg22-slc)
autogen/
cmake_gcc/build/
*.slps
artifact/

# Nordic SDK (targets/nrf52-sdk)
_build/

# Build artefacts
*.o
*.a
*.elf
*.bin
*.hex
*.uf2
*.map
*.gbl

# Release output. `targets/esp32-idf/build.sh` delivers merged, ready-to-flash images here.
# The *.bin rule above already covers the images; this also catches MANIFEST.txt, which is
# generated alongside them and is build output, not a checked-in record. Ignoring the whole
# directory keeps `git status` quiet after a build -- and release artefacts belong on a
# release, not in history.
/release/

# Editors / OS
.vscode/
.idea/
.DS_Store
*.swp

# Secrets and provisioning — never commit these
*.pem
*.key
secrets.*
factory_config*.hex

# ESP-IDF build artefacts (targets/esp32-idf builds out-of-tree, but idf.py defaults to ./build)
build/
sdkconfig
sdkconfig.old

# Agent worktrees -- transient, and each is its own git repo. Never part of a commit here.
.claude/worktrees/

# IDF component-manager lock file. Generated because the vendored mdns component carries its
# own idf_component.yml; it records only `idf` itself (nothing is fetched -- the component is
# found locally), and it is REWRITTEN PER BOARD with that board's `target:` line, so committing
# it would mean a diff on every build of a different board.
dependencies.lock

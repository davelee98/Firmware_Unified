/*
 * Optional board defaults — runtime display pins come from OpenDisplay config.
 */
/ {
	chosen {
		zephyr,console = &uart20;
	};

	/*
	 * Expose all 8 SAADC channels (board DTS channel@0..7 => AIN0..AIN7) so
	 * the battery driver can pick one at runtime by index from the
	 * configured battery_sense_pin (P1.0n => AINn).
	 */
	zephyr,user {
		io-channels = <&adc 0>, <&adc 1>, <&adc 2>, <&adc 3>,
			      <&adc 4>, <&adc 5>, <&adc 6>, <&adc 7>;
	};
};

/*
 * The display is driven by a GPIO bit-bang SPI on the OpenDisplay config pins
 * (P2.1 CLK, P2.2 DATA). The board enables the spi00 SPIM peripheral on those
 * same pads, so leaving it on lets the peripheral contend with the bit-bang
 * output and corrupts the panel data. No firmware path uses the Zephyr SPI API,
 * so keep the pins as plain GPIO.
 */
&spi00 {
	status = "disabled";
};

/* Onboard IMU is unused on the ePaper breakout; skip its failing boot probe. */
&lsm6ds3tr_c {
	status = "disabled";
};

/*
 * The board enables i2c22 on P1.10 (D4) and P1.11 (D5) as open-drain I2C with
 * pull-ups. The display BUSY line is on D5/P1.11, so leaving i2c22 on pins BUSY
 * high permanently (the I2C idle level) instead of following the panel — which
 * makes every bbepWaitBusy() time out. No firmware path uses the Zephyr I2C API,
 * so free the pin for GPIO use.
 */
&i2c22 {
	status = "disabled";
};

/*
 * RECLAIM THE FLPR's SRAM: 188 KB -> 256 KB.
 *
 * The stock nrf54l15.dtsi splits the part's 256 KB as 188 KB cpuapp + 68 KB cpuflpr_sram at
 * 0x2002f000. That split is a devicetree convention, not hardware arbitration: the nRF54L MPC
 * has two owners -- KMU and everything else -- so the M33 and the FLPR are the same owner, and
 * the only hardware-fixed override protects CRACEN RAM. Nordic ships this same override in the
 * Matter lighting-app sample, and their own non-secure cpuapp dtsi already gives the app all
 * 256 KB.
 *
 * VALID ONLY WHILE NO FLPR IMAGE RUNS. This firmware never builds or starts one, and a secure
 * cpuapp build deletes the cpuflpr_sram/cpuflpr_rram nodes outright, leaving the region
 * unowned. Enabling the nordic-flpr snippet would move the boundary again (to 160 KB) and this
 * override must be dropped in the same change.
 *
 * cpuapp_rram is deliberately NOT widened. Its FLPR reservation begins at 0x165000, exactly
 * where the partition table ends, so claiming it means growing slot0 and slot1 -- which
 * MCUboot's swap requires to stay equal in size -- and that moves slot1's base address,
 * breaking DFU against already-fielded devices. The SRAM reclaim carries no such cost.
 */
&cpuapp_sram {
	reg = <0x20000000 DT_SIZE_K(256)>;
	ranges = <0x0 0x20000000 0x40000>;
};

/*
 * Watchdog and its retained byte. Both ship disabled on nRF54L (the SoC dtsi does not enable
 * either), while the nRF52840 gets both from nrf52840.dtsi -- so this overlay is what makes one
 * src/od_hal_wdt.c serve all three boards.
 *
 * gpregret2 and NOT gpregret1: gpregret1 is retained-register 0, which MCUboot and the DFU
 * handshake use. See src/od_hal_wdt.c.
 */
&wdt31 {
	status = "okay";
};

&gpregret2 {
	status = "okay";
};

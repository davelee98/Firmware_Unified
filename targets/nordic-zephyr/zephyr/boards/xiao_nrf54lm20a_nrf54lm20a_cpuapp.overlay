/*
 * Optional board defaults — runtime display pins come from OpenDisplay config.
 */
/ {
	chosen {
		zephyr,console = &uart20;
	};

	/*
	 * Expose all 8 SAADC channels (board DTS channel@0..7 => AIN0..AIN7) so
	 * the battery driver can pick one at runtime by index from the
	 * configured battery_sense_pin (P1.0n => AINn).
	 */
	zephyr,user {
		io-channels = <&adc 0>, <&adc 1>, <&adc 2>, <&adc 3>,
			      <&adc 4>, <&adc 5>, <&adc 6>, <&adc 7>;
	};
};

/*
 * spi23 IS THE XIAO SPI ON THIS BOARD, and it sits on the panel bus.
 *
 * seeed_xiao_connector.dtsi maps `xiao_spi: &spi23`, and spi23_default psels are
 * SPIM_SCK P1.04 (D8) and SPIM_MOSI P1.06 (D10) -- the two pads the panel's CLK and DATA
 * are wired to. The board DTS leaves spi23 status = "okay", so the SPIM peripheral and the
 * firmware's bit-bang both drive them: two owners, one pad. The panel then receives no
 * valid transaction, never asserts BUSY, and every refresh ends in the 60 s
 * "BUSY NEVER ASSERTED" while the BLE image upload itself succeeds.
 *
 * spi00 is a different instance on P2.01/P2.02/P2.04 (the nRF54L15's panel bus, not this
 * board's). Nothing here uses the Zephyr SPI API, so both stay disabled and the pads stay
 * plain GPIO.
 */
&spi23 {
	status = "disabled";
};

&spi00 {
	status = "disabled";
};

/* Onboard IMU is unused on the ePaper breakout; skip its failing boot probe. */
&lsm6ds3tr_c {
	status = "disabled";
};

/*
 * i2c22 is the XIAO I2C here (seeed_xiao_connector.dtsi: `xiao_i2c: &i2c22`), and its
 * TWIM_SCL psel is P1.07 -- D5, the display BUSY line. Left enabled, the open-drain pull-up
 * holds BUSY at the I2C idle level instead of following the panel, so every bbepWaitBusy()
 * times out. TWIM_SDA is P1.03 (D4). No firmware path uses the Zephyr I2C API.
 */
&i2c22 {
	status = "disabled";
};

/*
 * Watchdog and its retained byte. Both ship disabled on nRF54L (the SoC dtsi does not enable
 * either), while the nRF52840 gets both from nrf52840.dtsi -- so this overlay is what makes one
 * src/od_hal_wdt.c serve all three boards.
 *
 * gpregret2 and NOT gpregret1: gpregret1 is retained-register 0, which MCUboot and the DFU
 * handshake use. See src/od_hal_wdt.c.
 */
&wdt31 {
	status = "okay";
};

&gpregret2 {
	status = "okay";
};

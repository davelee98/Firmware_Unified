CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions/default_8MB.csv"

# 8 MB module. IDF defaults to 2 MB, which rejects default_8MB.csv at partition-table
# generation -- a PlatformIO board_upload.flash_size knob with no -D equivalent.
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="8MB"

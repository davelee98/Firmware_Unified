# Common to every board. Per-chip settings go in sdkconfig.defaults.<idf_target>;
# per-board settings go in boards/<board>.cmake.


# NimBLE, not Bluedroid: the source uses NimBLE-Arduino, and the C API port keeps the same
# stack rather than adding a second migration. See docs/TOOLCHAINS.md.
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1

# Silence NimBLE's own INFO chatter. THREE reasons, and the second is the one that matters.
#
# The stack logs BLE_HS_LOG(INFO, ...) from inside itself -- "GATT procedure initiated: notify"
# plus "att_handle=16" on EVERY notify (ble_gattc.c:629), and a five-line block on every
# advertise/stop-advertise (ble_gap.c:3972, :4274). A 414-chunk PIPE_WRITE emits roughly 800
# extra UART lines.
#
# 1. Noise: it buries the firmware's own log at exactly the moments worth reading.
# 2. LINE CORRUPTION. od_log takes a mutex and writes to UART0; ESP_LOG writes to the same UART
#    with no shared lock. Two independent writers means records interleave MID-LINE, e.g.
#      ERX 0x0040 (31 B): 00 40 C8 19 ... 27 B6 00I (137013) NimBLE: GATT procedure initiated...
#    Every hex dump in a capture taken this way is suspect, which cost real debugging time.
# 3. Throughput: ~2 UART lines per chunk is a fixed per-chunk cost paid on the loop task.
#
# WARNING, NOT NONE OR ERROR: a genuine host-stack warning or error is worth seeing, and this is
# compile-time, so the format strings come out of flash too.
#
# WHY THIS WAS NEVER A PROBLEM UNDER ARDUINO, and it is not the NimBLE setting -- that is INFO
# in both builds. pioarduino's precompiled sdkconfig sets CONFIG_LOG_DEFAULT_LEVEL=1 and
# CONFIG_LOG_MAXIMUM_LEVEL=1 (ERROR), and MAXIMUM_LEVEL is a compile-time ceiling that strips
# every ESP_LOGI in the firmware -- NimBLE's included. IDF defaults both to 3 (INFO) and this
# project never named the symbol, so it inherited INFO. Same class of finding as the
# universal-MAC count: a behaviour silently inherited from a framework sdkconfig nobody saw.
# See docs/DIVERGENCE_MATRIX.md 7a.
#
# The global ceiling is deliberately NOT lowered to match Arduino. That would also strip OUR
# useful ESP_LOGI lines -- od_ble's resolved identity-address type and GATT val_handle, and the
# bbep BUSY-wait timeout warning that made the dark-panel diagnosis possible. Silence the noisy
# component, not the whole log.
CONFIG_BT_NIMBLE_LOG_LEVEL_WARNING=y

# The source builds C++ with exceptions and RTTI off under Arduino; keep that, since shared/
# is C and the target code gains nothing from either.
CONFIG_COMPILER_CXX_EXCEPTIONS=n
CONFIG_COMPILER_CXX_RTTI=n

# platformio.ini set -DCONFIG_FREERTOS_WATCHDOG_TIMEOUT_S=120 as a define, which under IDF is
# a real Kconfig symbol -- setting it here is the correct translation.
# IDF caps this Kconfig at [1,60]; platformio.ini asked for 120 via -D, which the Arduino
# core accepted. 60 is the closest legal value -- a real translation finding, not a typo.
CONFIG_ESP_TASK_WDT_TIMEOUT_S=60

# TLS-PSK for the LAN transport (SECTION 9: TLS-PSK on server_port + 1). IDF defaults the
# PSK key-exchange modes OFF, so mbedtls_ssl_conf_psk() does not exist without this. The
# Arduino build got it enabled by default -- a translation finding, not a preference: without
# it the encrypted LAN port silently fails to build.
CONFIG_MBEDTLS_PSK_MODES=y
CONFIG_MBEDTLS_KEY_EXCHANGE_PSK=y

# ---------------------------------------------------------------------------------------
# Restored to the Arduino build's values (2026-08-04). Not preferences -- unchosen drift.
# ---------------------------------------------------------------------------------------
# Found by diffing this target's EFFECTIVE sdkconfig against the precompiled Arduino core
# sdkconfigs the reference firmware links (~/.platformio/packages/framework-arduinoespressif32-
# libs/<chip>/sdkconfig). 77 behaviour-relevant differences on the S3, of which only six were
# ones this project had declared. The rest are IDF defaults inherited by saying nothing -- and
# a difference nobody declared is a defect in the port, not a configuration choice.
#
# tools/sdkconfig_baseline.sh now gates the whole effective config so this class of drift
# surfaces as a diff to approve rather than as behaviour discovered months later.

# TICK RATE. IDF defaults to 100 Hz; the Arduino core ships 1000 Hz, so portTICK_PERIOD_MS was
# 1 in the reference firmware and became 10 here. That is not merely coarser -- it silently
# breaks every sub-10 ms wait: pdMS_TO_TICKS(2) evaluates to ZERO ticks, and vTaskDelay(0)
# yields without blocking. src/session_guard.cpp's R3a link-down poll is exactly this case, so
# it has been busy-spinning at loop-task priority through every BLE teardown on this target
# while working correctly on the shipped firmware. Fixing the tick rate fixes the whole class
# at the root, and makes every existing short-delay call site mean what its author wrote.
CONFIG_FREERTOS_HZ=1000

# OPTIMIZATION. The Arduino core builds -Os (SIZE); this target inherited IDF's -Og (DEBUG).
# Nobody chose a debug build -- it is what happens when the symbol is never named. Restoring
# -Os also matters for a shipped board: c6-n4 has 23% slot headroom against 62-81% elsewhere.
CONFIG_COMPILER_OPTIMIZATION_SIZE=y

# TASK WATCHDOG: PANIC, i.e. reset, not just log. The Arduino build panics; this target
# inherited log-only, so a wedged loop() never recovers. That backstop matters MORE here than
# upstream, because bbepWaitBusy() can hold the loop task for 16-30 s on a panel that will not
# answer (README known defects, item 2). Timeout stays 60 s -- see the note above, where IDF's
# [1,60] cap forced it.
CONFIG_ESP_TASK_WDT_PANIC=y

# ...and DO NOT watch the CPU1 idle task, which the Arduino build also does not. Enabling
# PANIC while watching an idle task the reference never watched would not restore its
# behaviour, it would invent a new reset source. The two settings are one decision.
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU1=n

# ---------------------------------------------------------------------------------------
# mDNS -- ADVERTISE ONLY. This device announces `_opendisplay._tcp` so Home Assistant can
# find it; it NEVER resolves a name or browses for a service (decided 2026-08-04).
# ---------------------------------------------------------------------------------------
# The component has no responder-only build flag -- mdns_querier.c and mdns_browser.c compile
# in regardless -- so "advertise only" is expressed here, in what the responder is sized for.
# Every value below is a REDUCTION from the component's default; nothing is enabled.
#
# Applies on every board, including the five that compile no WiFi surface at all. That is
# harmless: the component is only linked where main references it (see main/CMakeLists.txt).

# ONE service: _opendisplay._tcp. Default is 10. Adding a second would need this raised, and
# the wire contract (SECTION 9 rule 6) defines exactly one.
CONFIG_MDNS_MAX_SERVICES=1

# ONE interface: the WiFi station. Default is 3 (STA + AP + Ethernet). This device is never an
# AP and has no Ethernet, and the count is static RAM in the responder's per-interface state.
CONFIG_MDNS_MAX_INTERFACES=1
CONFIG_MDNS_PREDEF_NETIF_STA=y
CONFIG_MDNS_PREDEF_NETIF_AP=n

# CONSOLE CLI DEFAULTS TO **y** UPSTREAM -- an interactive mdns command set on the device
# console, with a `console` component dependency behind it. There is no console on a battery
# e-paper tag, and a CLI that can add and remove service records is attack surface on a device
# whose whole LAN authentication story is the TLS-PSK on the data port.
CONFIG_MDNS_ENABLE_CONSOLE_CLI=n

# One instance per service type. Default y allows several, which only costs bookkeeping here.
CONFIG_MDNS_MULTIPLE_INSTANCE=n

# Reverse (in-addr.arpa) lookups stay OFF -- already the default, stated because it is exactly
# the "resolve" half of mDNS that this device does not do.
CONFIG_MDNS_RESPOND_REVERSE_QUERIES=n

# NOT SET, DELIBERATELY, and each is a measure-first item:
#   CONFIG_MDNS_TASK_STACK_SIZE (4096) -- mDNS runs its own FreeRTOS task. Trim only against a
#     measured high-water mark; a stack overflow here presents as a crash on an incoming query.
#   CONFIG_MDNS_MEMORY_ALLOC_SPIRAM -- tempting on the S3, but the mDNS task also serves
#     packets from the lwIP context, and moving its allocations to PSRAM has cache-coherency
#     implications that need testing rather than reasoning.
#   CONFIG_MDNS_TIMER_PERIOD_MS (100) -- the announcement/retransmit tick. Lengthening it is a
#     radio-duty-cycle win on battery, but it also slows first discovery after a wake.
